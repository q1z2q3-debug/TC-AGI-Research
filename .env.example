# TC-AGI-Research 环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）

# DeepSeek API 密钥（接入真实 LLM 认知；留空则使用本地规则引擎）
DEEPSEEK_API_KEY=
# 可选：自定义端点 / 模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 持久化循环间隔（秒）
LOOP_INTERVAL_SEC=30

# 语义嵌入检索（本地 Ollama，零成本；不可用时自动回退关键词匹配）
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# 先确保本机已拉取模型：ollama pull nomic-embed-text

# 认知 HTTP 服务
COGNITIVE_PORT=8899
COGNITIVE_HOST=0.0.0.0
# 可选：设置后启用 API Key 认证（请求头 X-API-Key 或 Authorization: Bearer）
COGNITIVE_API_KEY=
# 可选：CORS 允许来源，默认 *
COGNITIVE_CORS_ORIGIN=*
# 可选：请求体最大字节数，默认 1MB
COGNITIVE_MAX_BODY_BYTES=1048576
# 可选：文本字段最大长度，默认 10000
COGNITIVE_MAX_TEXT_LENGTH=10000

# 日志级别：debug/info/warn/error，默认 info
LOG_LEVEL=info

