# TC-AGI-Research 环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）

# DeepSeek API 密钥（接入真实 LLM 认知；留空则使用本地规则引擎）
DEEPSEEK_API_KEY=
# 可选：自定义端点 / 模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 持久化循环间隔（秒）
LOOP_INTERVAL_SEC=30

# 语义嵌入检索（本地 Ollama，零成本；不可用时自动回退关键词匹配）
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# 先确保本机已拉取模型：ollama pull nomic-embed-text

