# ═══════════════════════════════════════════════════════════════
# TC-AGI 九维平衡三进制认知空间 — 环境配置参数
# ═══════════════════════════════════════════════════════════════
# 将此文件内容合并到项目根目录 .env 中
# 或在启动时通过 COGSPACE_ENV_FILE 环境变量指定独立配置文件路径

# ━━━ 认知空间维度权重 ━━━
# 时间维度组权重（自然常数 e），控制时间三元对认知距离的影响
COG_E_WEIGHT=2.718281828459045
# 空间维度组权重（圆周率 π），控制空间三元对认知距离的影响
COG_PI_WEIGHT=3.141592653589793
# 因果维度组权重（欧拉-马歇罗尼常数 γ），控制因果三元对认知距离的影响
COG_GAMMA_WEIGHT=0.5772156649015329

# ━━━ 收敛判定阈值 ━━━
# 认知收敛判定阈值（欧式距离），当 BiasToOrigin < 此值时判定为收敛
# 范围 [0, 6]，默认 2.5（对应约7维以下偏离平衡态）
# 调小 → 更严格，要求更接近平衡态才允许终止
# 调大 → 更宽松，允许更大的认知偏差
COG_CONVERGE_THRESHOLD=2.5

# ━━━ 极端认知判定阈值 ━━━
# 极端认知判定阈值（非零维度数量），当非零维度数 ≥ 此值时判定为极端
# 范围 [1, 9]，默认 7
# 调小 → 更敏感，更容易触发中和修正
# 调大 → 更宽松，允许更多维度偏离平衡
COG_EXTREME_THRESHOLD=7

# ━━━ 记忆召回参数 ━━━
# 记忆召回数量（TopK），每轮推理从记忆池召回的邻近认知数量
# 默认 3，范围 [1, 19683]
# 调大 → 更多上下文，但增加Prompt长度和推理开销
COG_TOPK_NUM=3

# ━━━ 快照持久化路径 ━━━
# 认知记忆池快照落盘路径
COG_SNAPSHOT_PATH=./data/cog_memory_snapshot.json

# ━━━ 时序遗忘衰减参数（扩展预留） ━━━
# 时间衰减因子，用于带衰减的TopK召回
# 0.0 = 不衰减（纯距离召回），1.0 = 强衰减
COG_DECAY_FACTOR=0.1

# ━━━ 动态调参方案 ━━━
# 以下参数可根据场景动态调整，无需重启服务：
#
# 1. 创意发散场景：降低收敛阈值至 1.5，降低极端阈值至 5
#    → 允许更大认知偏差，鼓励多角度探索
#
# 2. 严谨推理场景：提高收敛阈值至 3.0，提高极端阈值至 8
#    → 要求更接近平衡态，抑制发散思维
#
# 3. 长期记忆场景：提高 TopK 至 5-10，提高衰减因子至 0.3
#    → 召回更多历史认知，但偏好近期记忆
#
# 4. 快速响应场景：降低 TopK 至 1-2，降低收敛阈值至 2.0
#    → 减少上下文注入，加快推理速度
